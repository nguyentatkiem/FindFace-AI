# App tìm ảnh khuôn mặt — biến môi trường (dev có mặc định, production PHẢI đặt đủ)
# Bí mật ký cookie phiên (dùng chung PHIEN_BI_MAT với internal/portal)
PHIEN_BI_MAT=
# Mật khẩu vào khu quản trị /quan-tri
TIM_ANH_MAT_KHAU_QUAN_TRI=
# Dịch vụ khuôn mặt Python (apps/dich-vu-khuon-mat)
DICH_VU_KHUON_MAT_URL=http://127.0.0.1:8100
# Gốc kho dữ liệu ảnh (mặc định <repo>/du-lieu/tim-anh)
TIM_ANH_THU_MUC=
# Ngưỡng cosine nhận cùng người (mặc định 0.38 — tinh chỉnh bằng ảnh khóa học thật)
TIM_ANH_NGUONG=
# Gốc URL công khai in trong QR (mặc định lấy từ host của request)
TIM_ANH_URL_GOC=
# --- Tính năng mở rộng (tùy chọn) ---
# Gửi email (báo ảnh mới về album + gửi link hàng loạt): SMTP bất kỳ (Gmail App Password/Brevo/Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Nhập ảnh từ thư mục Google Drive chia sẻ công khai
GOOGLE_API_KEY=
# Bắt kiểm tra người thật trước khi tìm (quay nhẹ đầu trái-phải)
TIM_ANH_LIVENESS=
